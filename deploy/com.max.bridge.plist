<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.max.bridge</string>
	<key>WorkingDirectory</key>
	<string>__ROOT__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ROOT__/max/.venv/bin/python3</string>
		<string>-u</string>
		<string>-m</string>
		<string>max.bridge</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/max_bridge.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/max_bridge.log</string>
</dict>
</plist>
