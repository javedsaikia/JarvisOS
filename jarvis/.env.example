# Copy the lines you need into jarvis/.env (same directory, gitignored)
# and paste your keys after the "=". Nothing here is read directly —
# jarvis/env.py only ever loads .env, and config.json never holds a key.
#
# After adding a key, restart the bridge/voice loop; the model then shows
# as selectable in the web UI's Models card.

# Groq — https://console.groq.com/keys
# Models: llama-3.1-8b-instant, llama-3.3-70b-versatile (see config.json "models")
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Also enables the optional cloud vision fallback for screen questions
# (screen_cloud_fallback, off by default and confirmed before it sends).
GEMINI_API_KEY=

# Sarvam — text-to-speech and the Hindi/Assamese paths
SARVAM_API_KEY=

# Spotify — playback control
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
