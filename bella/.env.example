# Copy the lines you need into bella/.env (same directory, gitignored)
# and paste your keys after the "=". Nothing here is read directly —
# bella/env.py only ever loads .env, and config.json never holds a key.
#
# After adding a key, restart the bridge/voice loop; the model then shows
# as selectable in the web UI's Front card (hover to inspect).

# Groq — https://console.groq.com/keys
# Models: llama-3.1-8b-instant, llama-3.3-70b-versatile (see config.json "models")
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Also enables the optional cloud vision fallback for screen questions
# (screen_cloud_fallback, off by default and confirmed before it sends).
GEMINI_API_KEY=

# Sarvam — TTS, Hindi/Assamese chat, and Assamese/Hindi speech-to-text
SARVAM_API_KEY=

# Bhashini / Udyat — Assamese ASR + TTS (https://bhashini.gov.in/ulca/profile)
#   BHASHINI_USER_ID        My Profile → User ID
#   BHASHINI_ULCA_API_KEY   My Profile → Generate (ulcaApiKey for config calls)
#   BHASHINI_INFERENCE_KEY  Your app → inference API key (Authorization on compute)
# Test: bella/.venv/bin/python3 -m bella.bhashini_client check
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_KEY=

# Spotify — playback control
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Composio — connected-app tools (Gmail, Calendar, etc.)
# https://dashboard.composio.dev
COMPOSIO_API_KEY=

# OMDb — movie and TV facts (https://www.omdbapi.com)
OMDB_API_KEY=

# Optional Maxun robot for listing extract (movies/hotels/flights).
# Leave blank: Bella uses public search pages instead. Read-only.
# Never put booking-site passwords here.
MAXUN_API_KEY=
MAXUN_API_URL=https://app.maxun.dev
MAXUN_ROBOT_ID=

# ElevenLabs — the default English voice (bella/elevenlabs_client.py).
# Also read from the real environment, so `export ELEVENLABS_API_KEY=...`
# works without editing this file. Pick a voice with:
#   bella/.venv/bin/python3 -c "from bella import elevenlabs_client as e; print(e.voices())"
# and put its voice_id in bella/config.json as tts_voice_id.
ELEVENLABS_API_KEY=
